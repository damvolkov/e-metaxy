# Copy to .env — the house's stack, by default: every URL below is the service already running on this host.
# Variables are the field names of each settings cluster (organon's own: infra/config/services.py — ORGANON_*).
# The materialized common still reads its old scopes (POSTGRES_DSN, QUEUE_DSN…); its code defaults do not point at the
# house's ports, so they are set here until e-arkhetypo's common migrates to the new settings doctrine.

##### APP #####
APP_ENV=local
APP_HOST=127.0.0.1
# e-organon's port (e-metaxy's, which it replaces)
APP_PORT=45190
# CRYPTO__SECRET=                    # required at runtime: crypto master root (Crypto.generate_keys())
# AUTH_SECRET=                       # the key account ids are minted under (openssl rand -hex 32)
# AUTH_TTL=                          # how long a key holds, ISO 8601 (P30D); unset, until revoked
AUTH_ADMIN=admin

##### SERVICES (organon) #####
# where a tool's path argument may point
ORGANON_ROOTS=["~/.config/memory","~/workspaces"]
# tekton: the profile book, the projects' root, the runs in flight, the Claude Code CLI
# TEKTON_PROFILES=profiles.yaml  # unset: the bridge is off
# TEKTON_WORKSPACES=~/workspaces
# TEKTON_LIMIT=4
# TEKTON_CLAUDE=claude

##### DRIVERS — the house's stack #####
# paradedb; the database is created at startup
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:45011/organon
# the queue's own database, created at startup (jobs: pgqueuer)
QUEUE_DSN=postgresql://postgres:postgres@127.0.0.1:45011/organon_background
# docling-serve: tables, figures, scans
DOCLING_URL=http://127.0.0.1:45800
# TEI embed
EMBED_URL=http://127.0.0.1:45110
# TEI reranker
RERANK_URL=http://127.0.0.1:45120
# gliner NER
GLINER_URL=http://127.0.0.1:45170
# vLLM (organon calls no LLM; common's driver needs a URL)
LLM_URL=http://127.0.0.1:45100/v1
# the sqlite store
DB_PATH=data/organon.db

##### DOORS #####
MCP_PATH=/mcp
DOCS_PATH=/docs
