# Copy to .env — runtime config, every value optional (defaults live in the code).
# infra/, ops/, ports/, providers/, engines/ and processors/ are materialized from ../common: edit them there, never here.
#
# APP_ENV=dev                    # dev | local | prod (logger rendering)
# APP_HOST=127.0.0.1
# APP_PORT=8000
# CRYPTO__SECRET=                # required at runtime: crypto master root (Crypto.generate_keys())
# ALLOW_ORIGINS=["*"]            # JSON lists decode from env
# ALLOW_METHODS=["GET","POST","PATCH","DELETE"]
# REDIS_URL=redis://localhost:6379/0
# DB_PATH=data/app.db           # the sqlite store (the user records); the directory is created on connect
# POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:45011/app   # accounts and keys; the database is created at startup when missing
# HTTP_BASE_URL=https://httpbin.org
# HTTP_TIMEOUT=10                # seconds, decoded to timedelta
# PING_TIMEOUT=PT2S              # ISO 8601 duration: one provider's health check, at startup and on GET /ready
# AUTH_SECRET=                   # the key account ids are minted under — never rotated; unset, no account can be made (openssl rand -hex 32)
# AUTH_TTL=                      # how long a key holds, ISO 8601 (P30D); unset, until revoked
# AUTH_ADMIN=admin               # the admin account's name; its first key: python -m e_organon admin
# MCP_PATH=/mcp                  # where the MCP endpoint answers
# MCP_HOSTS=[]                   # JSON list of the Host the transport accepts; empty: 127.0.0.1 and localhost on APP_PORT
# MCP_ORIGINS=[]                 # JSON list of the Origin it accepts; empty: http:// each host
# DOCS_PATH=/docs                # OpenAPI pages root (first renderer served at the root itself)
# DOCS_ALIASES=["/schema"]       # extra roots answering 307 to the same subpath under DOCS_PATH
# DOCS_RENDERERS=["swagger","redoc","elements","rapidoc"]  # also: scalar
