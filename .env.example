# e-metaxy — copy to ~/.config/e-metaxy/env (chmod 600); every key is optional.
METAXY_HOST=127.0.0.1
METAXY_PORT=45190
# bearer token callers must send (Authorization: Bearer …); unset = loopback only, no token
METAXY_TOKEN=
METAXY_PROFILES=profiles.yaml
METAXY_LEDGER=~/.local/share/e-metaxy/ledger.db
METAXY_LIMIT=4
METAXY_CLAUDE=claude
