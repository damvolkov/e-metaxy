# e-metaxy — copy to ~/.config/e-metaxy/env (chmod 600); every key is optional.
METAXY_HOST=127.0.0.1
METAXY_PORT=45190
# bearer token callers must send (Authorization: Bearer …); unset = loopback only, no token
METAXY_TOKEN=
METAXY_PROFILES=profiles.yaml
METAXY_LEDGER=~/.local/share/e-metaxy/ledger.db
METAXY_LIMIT=4
METAXY_CLAUDE=claude
# OpenHuman callback: its core /rpc and core token; unset token = no callback
METAXY_OPENHUMAN_URL=http://127.0.0.1:7788/rpc
METAXY_OPENHUMAN_TOKEN=
# its triage turn is an LLM call: the trigger answers when it ends (ISO 8601 duration)
METAXY_OPENHUMAN_TIMEOUT=PT5M
