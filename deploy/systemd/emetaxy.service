[Unit]
Description=emetaxy via Docker Compose — MCP gateway to Claude Code (host loopback :45190)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/damien/.config/compose/emetaxy
ExecStart=/usr/bin/docker compose up -d --wait --remove-orphans
ExecStop=/usr/bin/docker compose stop
ExecReload=/usr/bin/docker compose up -d --wait --remove-orphans
Restart=on-failure
RestartSec=30s
TimeoutStartSec=180
TimeoutStopSec=40

[Install]
WantedBy=default.target
